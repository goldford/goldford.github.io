---
layout: base.njk
title: CV (Government of Canada)
permalink: "{{ site.private_cv.url }}"
bodyClass: cvpage
noindex: true
description: CV of Greig Oldford for Government of Canada hiring managers.
---
{# Unlisted page. Not linked from the site; see site.private_cv in site.yaml. #}
{% macro cite(p) %}
<li class="cvpub">{{ p.authors | authors | safe }} ({{ p.year }}{% if p.status %}, {{ p.status }}{% endif %}). {{ p.title }}{% if not (p.title | last) in "?!." %}.{% endif %}
  {% if p.venue %}<em>{{ p.venue }}</em>{% if p.details %}, {{ p.details }}{% endif %}.{% endif %}
  {% if p.doi %}<a href="https://doi.org/{{ p.doi }}">https://doi.org/{{ p.doi }}</a>{% elif p.url %}<a class="cv-url" href="{{ p.url }}">link</a>{% endif %}</li>
{% endmacro %}

<article class="cv cv--gc wrap">
  <header class="cv__head">
    <div>
      <h1 class="cv__name">{{ site.name }}</h1>
      <p class="cv__role">{{ cvgc.headline }}</p>
      <p class="cv__aff">BSc · Adv. Dip. GIS · MES · PhD candidate (UBC)</p>
    </div>
    <div class="cv__contact">
      <p>{{ cvgc.contact.location }}</p>
      <p><a href="mailto:{{ cvgc.contact.email }}">{{ cvgc.contact.email }}</a></p>
      <p><a href="{{ site.url }}">goldford.github.io</a></p>
      <p><a href="{{ site.links.linkedin }}">linkedin.com/in/greig-oldford-1616385</a></p>
      <p class="screen-only cv__dl"><a class="btn btn--glow" href="{{ site.private_cv.pdf }}" download>Download PDF</a></p>
    </div>
  </header>

  <section class="cv__sec cv__top">
    <div class="cv__pools">
      <h2>Pre-qualified pools</h2>
      <ul class="cv__poollist">
        {% for p in cvgc.pools %}<li><strong>{{ p.level }}</strong><span class="mono">{{ p.process }}</span><span class="cv__org">{{ p.note }}</span></li>{% endfor %}
      </ul>
      <ul class="cv__status">
        {% for s in cvgc.status %}<li>{{ s }}</li>{% endfor %}
      </ul>
    </div>
    <div>
      <h2>Profile</h2>
      <p class="cv__profile">{{ cvgc.profile }}</p>
    </div>
  </section>

  <section class="cv__sec">
    <h2>Areas of strength</h2>
    <dl class="cv__skills">
      {% for s in cvgc.strengths %}<div><dt>{{ s.area }}</dt><dd>{{ s.items }}</dd></div>{% endfor %}
    </dl>
  </section>

  <section class="cv__sec">
    <h2>Selected results</h2>
    <ul class="cv__results">
      {% for r in cvgc.results %}<li>{{ r }}</li>{% endfor %}
    </ul>
  </section>

  <section class="cv__sec cv__sec--long">
    <h2>Experience · Fisheries and Oceans Canada</h2>
    <ol class="cv__list">
      {% for x in cvgc.positions %}
      <li><span class="cv__when">{{ x.when }}</span>
        <div><p><strong>{{ x.title }}</strong></p><p class="cv__org">{{ x.org }}</p>
        {% if x.notes %}<ul class="cv__notes">{% for n in x.notes %}<li>{{ n }}</li>{% endfor %}</ul>{% endif %}</div></li>
      {% endfor %}
    </ol>
  </section>

  <section class="cv__sec">
    <h2>Education</h2>
    <ol class="cv__list cv__list--tight">
      {% for e in cv.education %}
      <li><span class="cv__when">{{ e.when }}</span><div><p><strong>{{ e.degree }}</strong>, {{ e.org }}</p></div></li>
      {% endfor %}
    </ol>
  </section>

  <section class="cv__sec">
    <h2>Awards &amp; funding</h2>
    <ol class="cv__list cv__list--tight">
      {% for a in cv.awards | limit(5) %}<li><span class="cv__when">{{ a.when }}</span><span>{{ a.what }}</span></li>{% endfor %}
    </ol>
  </section>

  <section class="cv__sec">
    <h2>Science advice &amp; public engagement</h2>
    <ol class="cv__list cv__list--tight">
      {% for t in talks | where("highlight", true) | newestFirst | limit(5) %}
      <li><span class="cv__when">{{ t.date | monthYear }}</span><span>{{ t.title }}{% if not (t.title | last) in "?!." %}.{% endif %} <em>{{ t.venue }}</em>, {{ t.location }}.</span></li>
      {% endfor %}
    </ol>
  </section>

  <section class="cv__sec">
    <h2>Selected publications</h2>
    <ul class="cv__pubs">
      {% for p in publications | pick(["beaty2026", "oldford2025hotssea", "oldford2023fipex", "taft2022"]) %}{{ cite(p) }}{% endfor %}
    </ul>
    <p class="cv__org">Full list: <a href="{{ site.url }}/publications/">goldford.github.io/publications</a></p>
  </section>

  <p class="cv__foot">References available on request · Updated {{ build.label }}</p>
</article>
