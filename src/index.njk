        <div class="card__body">
          <p class="eyebrow">{{ r.kicker }}</p>
          <h3>{{ r.title }}</h3>
          <p>{{ r.short }}</p>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="talks-title">
  <div class="wrap">
    <div class="section__head">
      <div><p class="eyebrow">Talks &amp; appearances</p><h2 id="talks-title" class="display">On the record</h2></div>
      <a class="arrowlink" href="/talks/">All talks</a>
    </div>
    <div class="appear">
      {% for t in talks | where("highlight", true) | newestFirst %}
      <article class="appear__item reveal">
        <p class="mono appear__date">{{ t.date | monthYear }} · {{ t.type | capitalize }}</p>
        <h3>{% if t.url %}<a href="{{ t.url }}">{{ t.title }}</a>{% else %}{{ t.title }}{% endif %}</h3>
        <p class="muted">{{ t.venue }}</p>
        {% if t.abstract %}<p>{{ t.abstract }}</p>{% endif %}
      </article>
      {% endfor %}
    </div>
    <ul class="talkmini">
      {% for t in talks | whereNot("type", "lecture") | newestFirst | limit(5) %}
      <li><span class="mono">{{ t.date | monthYear }}</span><span>{{ t.title }}</span><span class="muted">{{ t.location }}</span></li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section contact" aria-labelledby="contact-title">
  <div class="wrap contact__inner reveal">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-title" class="display">Collaborations, models, data</h2>
    <p class="lead">Interested in ecosystem modelling of the Salish Sea, the HOTSSea hindcast, or FIPEX? The best way to reach me is LinkedIn.</p>
    {% include "links.njk" %}
  </div>
</section>
