<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set pageTitle = (title + " · " + site.name) if title else (site.name + " · " + site.role) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description or site.description | striptags | trim }}">
  <meta name="theme-color" content="#020a14">
  <meta name="color-scheme" content="dark">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description or site.description | striptags | trim }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/img/og.png">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="/assets/css/site.css">
  {% if pageCss %}<link rel="stylesheet" href="{{ pageCss }}">{% endif %}
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"Person","name":"{{ site.name }}","jobTitle":"{{ site.role }}","url":"{{ site.url }}",
   "affiliation":[{"@type":"Organization","name":"Fisheries and Oceans Canada"},{"@type":"Organization","name":"University of British Columbia"}],
   "sameAs":["{{ site.links.linkedin }}","{{ site.links.orcid }}","{{ site.links.github }}"]}
  </script>
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#main">Skip to content</a>
  <div class="ocean" aria-hidden="true"></div>

  <header class="masthead" data-masthead>
    <div class="wrap masthead__inner">
      <a class="brand" href="/" aria-label="{{ site.name }}, home">
        <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="25" r="3.2"/><circle cx="7" cy="16" r="2.4"/><circle cx="24" cy="14" r="2.6"/><circle cx="15" cy="6" r="2.2"/><path d="M16 25 7 16M16 25l8-11M7 16l8-10M24 14l-9-8"/></svg>
        <span class="brand__name">{{ site.name }}</span>
      </a>
      <button class="navtoggle" aria-expanded="false" aria-controls="sitenav" data-navtoggle>
        <span class="sr-only">Menu</span><span class="navtoggle__bars" aria-hidden="true"></span>
      </button>
      <nav id="sitenav" class="sitenav" aria-label="Main">
        <ul>
          {% for item in site.nav %}
          <li><a href="{{ item.url }}" {% if page.url.startsWith(item.url) %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="wrap footer__inner">
      <div>
        <p class="footer__name">{{ site.name }}</p>
        <p class="muted">Ecosystem science and modelling · {{ site.location }}</p>
      </div>
      {% include "links.njk" %}
      <p class="footer__meta mono">Updated {{ build.label }} · <a href="https://github.com/goldford/goldford.github.io">source</a></p>
    </div>
  </footer>

  <script src="/assets/js/site.js" defer></script>
  {% if pageJs %}<script src="{{ pageJs }}" defer></script>{% endif %}
</body>
</html>
